# Copia este archivo como .env en esta misma carpeta y cambia los valores.

# Primer administrador (solo se usa la primera vez que arranca)
ADMIN_USUARIO=Administrador
ADMIN_CLAVE=cambia-esta-clave

# Cadena larga y aleatoria (en Linux: openssl rand -hex 32)
SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-larga

# Sitio público que puede leer las vacantes
SITIOS_PERMITIDOS=https://sanpedroesmicoope.com.gt,https://www.sanpedroesmicoope.com.gt

# El servidor usa HTTPS
SESSION_COOKIE_SECURE=1
