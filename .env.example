# Copia este archivo como .env y cambia los valores.

# Primer administrador (solo se usa la primera vez; después los usuarios se gestionan en /admin)
ADMIN_USUARIO=Administrador
ADMIN_CLAVE=cambia-esta-clave

# Cadena larga y aleatoria
SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-larga

# Sitios que pueden leer las vacantes publicadas.
# En tu PC: la página pública abierta con Live Server de VS Code.
SITIOS_PERMITIDOS=http://127.0.0.1:5500,http://localhost:5500

# 1 solo si se sirve por HTTPS
SESSION_COOKIE_SECURE=0

# Puerto de tu PC donde se publica el servidor
PUERTO=5001
